  "mensagens": [
    "#main [data-pre-plain-text] .selectable-text",
    "#main [data-pre-plain-text] [data-testid~=\"selectable-text\"]",
    "#main [data-testid=\"msg-container\"] [data-testid=\"msg-meta\"]",
    "#main [data-testid=\"conversation-compose-box-input\"]",
    "#main [data-testid=\"compose-btn-send\"]",
    "#main [data-testid=\"msg-container\"] [data-testid=\"quoted-message\"] .selectable-text"
  ],
  "mensagemTarja": [
    "#main [data-testid=\"msg-container\"]"
  ],
  "nomesDentroDeTexto": [
    "[data-testid=\"quoted-message\"]",
    "[data-testid=\"author\"]",
    "[data-pre-plain-text] .selectable-text [role]:not(img)",
    "[data-pre-plain-text] .selectable-text [tabindex]:not(img)",
    "[data-pre-plain-text] .selectable-text [title]",
    "[data-testid=\"last-msg-status\"] > span[dir]:last-child [role]:not(img)",
    "[data-testid=\"last-msg-status\"] > span[dir]:last-child [title]",
    "[data-testid=\"profile-first-initial\"]",
    "[data-testid=\"profile-second-initial\"]"
  ],
  "midia": [
    "#main [data-testid=\"msgImage\"]",
    "#main [data-testid=\"msg-video\"]",
    "#main [data-testid=\"image-album\"]",
    "#main [data-testid=\"sticker-container\"]",
    "#main [data-testid=\"link-preview-thumbnail\"]",
    "#main [data-testid=\"chat_thread_gif_thumb_image\"]",
    "#main [data-testid=\"document-thumb-details\"]",
    "#main [data-testid=\"audio-play\"]",
    "#main [data-testid=\"ptt-status\"]",
